  <MdxScripts>
    <MdxScript dwd:design-time-name="15f355ef-88fb-4b90-bf0d-eee54f410afa">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[CM_On_Time_Delivery_Rate] AS
IIF(
    [Measures].[Completed Fulfillment Count] = 0,
    NULL,
    [Measures].[Delivery On Time Count] / [Measures].[Completed Fulfillment Count]
),
FORMAT_STRING = "Percent",
ASSOCIATED_MEASURE_GROUP = 'Fact Delivery Fulfillment';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>