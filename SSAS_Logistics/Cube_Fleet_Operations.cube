  <MdxScripts>
    <MdxScript dwd:design-time-name="8c1730b0-9083-4ce6-be5a-fc4bb2434c32">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Idle_Time_Percentage]
 AS IIF(
    ([Measures].[Actual Duration Hours] + [Measures].[Idle Time Hours]) = 0,
    0,
    CDbl([Measures].[Idle Time Hours]) / CDbl([Measures].[Actual Duration Hours] + [Measures].[Idle Time Hours])
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Trip';  
CREATE MEMBER CURRENTCUBE.[Measures].[MPG]
 AS [Measures].[Actual Distance Miles] / [Measures].[Fuel Gallons Used], 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>