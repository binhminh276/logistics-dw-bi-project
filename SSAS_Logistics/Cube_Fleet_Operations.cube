  <MdxScripts>
    <MdxScript dwd:design-time-name="e392ab98-b7d6-4ef0-b709-d33616dc507f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[CM_Idle_Time_Percentage] AS
IIF(
    ([Measures].[Actual Duration Hours] + [Measures].[Idle Time Hours]) = 0,
    0,
    [Measures].[Idle Time Hours] / ([Measures].[Actual Duration Hours] + [Measures].[Idle Time Hours])
),
FORMAT_STRING = "Percent",
ASSOCIATED_MEASURE_GROUP = 'Fact Trip';</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>