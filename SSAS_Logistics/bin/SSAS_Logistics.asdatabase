      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[CM_On_Time_Delivery_Rate] AS
IIF(
    [Measures].[Completed Fulfillment Count] = 0,
    NULL,
    [Measures].[Delivery On Time Count] / [Measures].[Completed Fulfillment Count]
),
FORMAT_STRING = "Percent",
ASSOCIATED_MEASURE_GROUP = 'Fact Delivery Fulfillment';
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Delivery Detention]
 AS [Measures].[Delivery Detention Minutes] / [Measures].[Total Fulfillment Count], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[On Time Pct]
 AS ([Measures].[Delivery On Time Count] / [Measures].[Total Fulfillment Count]) * 100, 
VISIBLE = 1  ; </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
