      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>CALCULATE;

/* -------------------------------------------------------------------------
   CALCULATED MEASURES CHO PHÂN HỆ QUẢN TRỊ BẢO DƯỠNG XE - PHÚC AN
   ------------------------------------------------------------------------- */

-- 1. Chi phí bảo dưỡng trung bình cho mỗi lần bảo dưỡng (Avg Maintenance Cost per Event)
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Avg_Maintenance_Cost] AS
IIF(
    [Measures].[Fact Maintenance Count] = 0,
    0,
    [Measures].[Total Maintenance Cost] / [Measures].[Fact Maintenance Count]
),
FORMAT_STRING = "Currency",
ASSOCIATED_MEASURE_GROUP = 'Fact Maintenance';

-- 2. Thời gian dừng xe trung bình cho mỗi đợt sửa chữa (Avg Downtime per Event)
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Avg_Downtime_Hours] AS
IIF(
    [Measures].[Fact Maintenance Count] = 0,
    0,
    [Measures].[Downtime Hours] / [Measures].[Fact Maintenance Count]
),
FORMAT_STRING = "#,##0.00",
ASSOCIATED_MEASURE_GROUP = 'Fact Maintenance';

-- 3. Chi phí nhân công trung bình mỗi giờ công (Hourly Labor Rate)
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Hourly_Labor_Rate] AS
IIF(
    [Measures].[Labor Hours] = 0,
    0,
    [Measures].[Labor Cost] / [Measures].[Labor Hours]
),
FORMAT_STRING = "Currency",
ASSOCIATED_MEASURE_GROUP = 'Fact Maintenance';

-- 4. Tỷ trọng chi phí phụ tùng trên tổng chi phí (Parts Cost Ratio %)
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Parts_Cost_Ratio] AS
IIF(
    [Measures].[Total Maintenance Cost] = 0,
    0,
    [Measures].[Parts Cost] / [Measures].[Total Maintenance Cost]
),
FORMAT_STRING = "Percent",
ASSOCIATED_MEASURE_GROUP = 'Fact Maintenance';
 
-- 5.
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Fleet_TCO] AS
(
    -- ValidMeasure() đảm bảo không sinh NULL khi ngữ cảnh chỉ có 1 trong 2 Fact
    -- Đơn giá 3.85 USD/gallon là giá trung bình EIA 2022-2024
    ValidMeasure([Measures].[Fuel Gallons Used]) * 3.85
    + ValidMeasure([Measures].[Total Maintenance Cost])
),
FORMAT_STRING = "Currency",
ASSOCIATED_MEASURE_GROUP = 'Fact Maintenance';
 </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
    <Cube>
      <ID>Cube_Fleet_Operations</ID>
      <Name>Cube_Fleet_Operations</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Annotations>
        <Annotation>
          <Name>http://schemas.microsoft.com/DataWarehouse/Designer/1.0:DiagramLayout</Name>
