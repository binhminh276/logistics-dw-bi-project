          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[CM_Revenue_Per_Pound] AS
IIF(
    [Measures].[Weight Lbs] = 0,
    0,
    [Measures].[Total Revenue] / [Measures].[Weight Lbs]
),
FORMAT_STRING = "$#,##0.0000",
ASSOCIATED_MEASURE_GROUP = 'Fact Load'; 
CREATE MEMBER CURRENTCUBE.[Measures].CM_avg_revenue_per_load
 AS IIF(
    [Measures].[Load Count] = 0,
    0,
    [Measures].[Total Revenue] / [Measures].[Load Count]
), 
FORMAT_STRING = "$#,##0.0000", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Load'  ;  
CREATE DYNAMIC SET CURRENTCUBE.[Top_10_Customers_Revenue]
 AS TOPCOUNT(
    [Dim_Customer].[Customer Name].[Customer Name].MEMBERS,
    10,
    [Measures].[Total Revenue]
); </Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
